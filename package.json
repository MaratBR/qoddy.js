{
	"name": "qoddy",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "vitest --run",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"qoddy": "node --disable-warning=ExperimentalWarning scripts/cli.ts",
		"test-db": "scripts/test-db.sh",
		"start": "node --disable-warning=ExperimentalWarning build"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"@fontsource-variable/alegreya": "^5.3.0",
		"@fontsource-variable/bodoni-moda": "^5.3.0",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0"
	}
}
